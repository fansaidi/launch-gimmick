# Supabase project's Postgres connection string (Settings -> Database ->
# Connection string -> URI). Use the "Session pooler" URI for this server.
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# Settings -> API. Used only to derive the JWKS URL for verifying user
# access tokens locally - no secret key needed for this.
SUPABASE_URL=https://your-project.supabase.co

PORT=3001
