# Supabase project's Postgres connection string (Settings -> Database ->
# Connection string -> URI). Use the "Session pooler" URI for this server.
DATABASE_URL=postgres://postgres:password@localhost:5432/postgres

# Settings -> API. The service role key must stay server-side only - it
# bypasses Row Level Security and is used here solely to verify user
# access tokens.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

PORT=3001
